# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: SQLAlchemy database URI.
# Defaults to local SQLite (sqlite:///backend/pillsync.db) for quick tests.
# For MySQL production, set: mysql+pymysql://root:password@localhost:3306/pillsync
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pillsync

# PILLSYNC_JWT_SECRET: Secret key used by Flask backend to sign HS256 JWT tokens.
PILLSYNC_JWT_SECRET=""
